// ============================================================================
// Barber Booking System — Prisma Schema
// Multi-tenant: every business-scoped table has a businessId column.
// Every query MUST filter by businessId to prevent cross-shop data leakage.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Business (Tenant) ──────────────────────────────────────────────────────

model Business {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // URL slug for the shop, e.g. "fade-factory"
  logo         String?
  primaryColor String   @default("#1a1a1a") // dark / black theme default
  accentColor  String   @default("#d4af37") // gold accent default
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  latitude     Float?
  longitude    Float?
  timezone     String   @default("America/Los_Angeles") // IANA timezone for all business logic
  instagram     String?
  facebook      String?
  tiktok       String?
  hours        Json? // { monday: { open: "09:00", close: "18:00", isOff: false }, ... }
  aboutText    String? @db.Text
  bookingPolicy String? @db.Text
  cancellationPolicy String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  barbers      Barber[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]
  blockedTimes BlockedTime[]
  reviews      Review[]
  auditLogs    AuditLog[]
  notificationLogs NotificationLog[]
  waitlistEntries    WaitlistEntry[]
  closures          BusinessClosure[]

  @@index([slug])
}

// ─── Users (Auth) ───────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  BARBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(BARBER)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId     String? // links to Barber profile when role = BARBER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]
  passwordResetToken    String?
  passwordResetExpires  DateTime?

  @@index([businessId])
}

// ─── Barbers ───────────────────────────────────────────────────────────────

model Barber {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  photo      String?
  specialty  String? // e.g. "Fades • Tapers • Beard Work"
  bio        String? @db.Text
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedules    Schedule[]
  appointments Appointment[]
  blockedTimes BlockedTime[]
  services     BarberService[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
}

// ─── Schedules (recurring weekly hours per barber) ─────────────────────────

model Schedule {
  id         String  @id @default(cuid())
  barberId   String
  barber     Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek  Int    // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime  String // "09:00" (24h)
  endTime    String // "18:00" (24h)
  isOff      Boolean @default(false)
  breaks     Json?  // [{ start: "12:00", end: "13:00" }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

// ─── Services ──────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  duration    Int     // minutes
  price       Float   // informational only — payment is in person
  isActive    Boolean @default(true)
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barbers      BarberService[]
  appointments Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
}

// Junction: which barbers offer which services
model BarberService {
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}

// ─── Customers ────────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String
  email      String
  notes      String?  @db.Text
  smsConsent Boolean  @default(false)
  archivedAt DateTime? // soft-delete support
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments Appointment[]
  waitlistEntries WaitlistEntry[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([businessId, phone])
}

// ─── Appointments ──────────────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Appointment {
  id                 String           @id @default(cuid())
  confirmationNumber String           @unique // human-readable, e.g. BRB-8F42K
  customerAccessToken String          @unique // crypto.randomBytes(32).hex — authenticates customer actions
  idempotencyKey     String?          @unique
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barberId          String
  barber            Barber            @relation(fields: [barberId], references: [id])
  serviceId         String
  service           Service           @relation(fields: [serviceId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(PENDING)
  customerNotes     String?          @db.Text
  cancellationReason String?
  createdBy         String? // "ONLINE" | "MANUAL" | userId
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  notificationLogs  NotificationLog[]

  @@index([businessId, startTime])
  @@index([businessId, barberId, startTime])
  @@index([businessId, status])
  @@index([barberId, startTime])
  @@index([customerId])
  @@index([confirmationNumber])
  @@index([customerAccessToken])
}

// ─── Blocked Time (vacation, time off, custom blocks) ─────────────────────

model BlockedTime {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId   String?  // null = shop-wide block
  barber     Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, barberId])
  @@index([businessId, startTime])
}

// ─── Reviews ──────────────────────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int // 1-5
  comment     String? @db.Text
  isFeatured  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

// ─── Waitlist ─────────────────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String? // link if customer exists
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  phone       String
  email       String
  barberId    String? // null = any barber
  barber      Barber?       @relation(fields: [barberId], references: [id], onDelete: SetNull)
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  preferredDate DateTime @db.Date
  preferredTimeRange String? // e.g. 'morning', 'afternoon', 'evening'
  status      WaitlistStatus @default(WAITING)
  notes       String?
  notifiedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([businessId, status])
  @@index([businessId, preferredDate])
}

// ─── Notification Log ──────────────────────────────────────────────────────
// Tracks every notification attempt (email/SMS) and its delivery status.

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  CANCELLATION_NOTICE
  RESCHEDULE_NOTICE
  CONTACT_FORM
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationLog {
  id          String            @id @default(cuid())
  businessId  String?
  business    Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String? // optional link to appointment
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipient   String // email or phone
  channel     NotificationChannel
  type        NotificationType
  status      NotificationStatus  @default(PENDING)
  errorMessage String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([businessId, createdAt])
  @@index([appointmentId])
  @@index([status])
}

// ─── Audit Log ─────────────────────────────────────────────────────────────
// Records every significant administrative action for accountability.

enum AuditAction {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  BARBER_CREATED
  BARBER_UPDATED
  BARBER_DEACTIVATED
  SCHEDULE_MODIFIED
  BLOCKED_TIME_ADDED
  BLOCKED_TIME_REMOVED
  USER_INVITED
  USER_PASSWORD_CHANGED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  SETTINGS_UPDATED
}

model AuditLog {
  id          String      @id @default(cuid())
  businessId  String?
  business    Business?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  String? // "Appointment", "Customer", "Service", etc.
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
  @@index([action])
}

// ─── Business Closures (Holidays / Special Hours) ──────────────────────────
// Owner-managed closure periods: holidays, vacations, special hours, etc.
model BusinessClosure {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String   // e.g. "Christmas Day", "Summer Vacation"
  description String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isAllDay    Boolean  @default(true)
  // For partial-day closures (isAllDay = false)
  startTime   String?  // "09:00"
  endTime     String?  // "14:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, startDate, endDate])
}
