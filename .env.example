# ============================================================================
# Barber Shop Booking System — Environment Variables
# ============================================================================
# This is a TEMPLATE. Each shop owner configures their own environment
# variables in Vercel (or .env for local development).
#
# REQUIRED for deployment:
# 1. DATABASE_URL — PostgreSQL connection string
# 2. NEXTAUTH_SECRET — random 32+ char string (openssl rand -base64 32)
# 3. NEXTAUTH_URL — the public URL of your deployment
#
# ONBOARDING FLOW:
# 1. First visit to /setup → create owner account (email + password only)
# 2. Login at /login → redirected to /dashboard/create-shop
# 3. Enter shop details → shop is created and linked to your account
# 4. Full dashboard becomes available
# ============================================================================

# Database (REQUIRED)
DATABASE_URL="postgresql://username:password@localhost:5432/barber_booking?schema=public"

# NextAuth (REQUIRED — build will fail without NEXTAUTH_SECRET in production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Email (Nodemailer - SMTP) — optional, for booking confirmations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@yourbarbershop.com"

# SMS (optional - Twilio)
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="your-sid"
# TWILIO_AUTH_TOKEN="your-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# App Config
NEXT_PUBLIC_APP_NAME="BarberOS"

# Demo mode (set to 'true' ONLY for single-tenant demos — never in production)
# DEMO_MODE="true"
