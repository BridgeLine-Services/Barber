{
  "name": "barber-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant barber shop website with booking engine and dashboard. No online payments \u2014 pay in person.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:tenant": "npx tsx tests/tenant-isolation.test.ts",
    "test:booking": "npx tsx tests/booking.test.ts",
    "test:permissions": "npx tsx tests/role-permissions.test.ts",
    "test:all": "npm run test:tenant && npm run test:booking && npm run test:permissions"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^5.19.0",
